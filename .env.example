# Host settings
TZ=America/Los_Angeles
SERVER_IP=192.168.1.10
DNS_BIND_ADDRESS=0.0.0.0
WEB_BIND_ADDRESS=0.0.0.0
JELLYFIN_DISCOVERY_BIND_ADDRESS=0.0.0.0

# Local DNS names. home.arpa is reserved for home networks.
JELLYFIN_HOSTNAME=watch.home.arpa
PIHOLE_HOSTNAME=dns.home.arpa
PORTAINER_HOSTNAME=portainer.home.arpa

# Generate a unique password before deployment.
PIHOLE_PASSWORD=replace-with-a-long-random-password
UPSTREAM_DNS=1.1.1.1;1.0.0.1

# Jellyfin host paths and permissions
MEDIA_PATH=/srv/media
PUID=1000
PGID=1000

# Only needed by compose.intel.yaml. Find these with:
# getent group video; getent group render
VIDEO_GID=44
RENDER_GID=109

# Image tags may be pinned here for reproducible deployments.
PIHOLE_IMAGE=pihole/pihole:latest
JELLYFIN_IMAGE=jellyfin/jellyfin:latest
PORTAINER_IMAGE=portainer/portainer-ce:lts
CADDY_IMAGE=caddy:2-alpine

